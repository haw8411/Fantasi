diff --git a/src/common/tusb_mcu.h b/src/common/tusb_mcu.h
index 0a4462a..0629f7b 100644
--- a/src/common/tusb_mcu.h
+++ b/src/common/tusb_mcu.h
@@ -140,6 +140,13 @@
   #define TUP_DCD_ENDPOINT_MAX    6
   #define TUD_ENDPOINT_ONE_DIRECTION_ONLY
 
+#elif TU_CHECK_MCU(OPT_MCU_AT91SAM7S)
+  /* SAM7S UDP has 4 hardware endpoints (EP0-EP3). Same direction
+   * restriction as SAMG - the CSR EPTYPE field encodes direction,
+   * so a given EP number is either IN or OUT. */
+  #define TUP_DCD_ENDPOINT_MAX    4
+  #define TUD_ENDPOINT_ONE_DIRECTION_ONLY
+
 #elif TU_CHECK_MCU(OPT_MCU_SAMX7X)
   #define TUP_DCD_ENDPOINT_MAX    10
   #define TUP_RHPORT_HIGHSPEED    1
@@ -380,6 +387,14 @@
   #define TUP_USBIP_DWC2
   #define TUP_DCD_ENDPOINT_MAX    4
 
+//--------------------------------------------------------------------+
+// Artery
+//--------------------------------------------------------------------+
+#elif TU_CHECK_MCU(OPT_MCU_AT32F435)
+  // AT32F435 OTGFS is a Synopsys DWC2 full-speed core (8 bidir endpoints).
+  #define TUP_USBIP_DWC2
+  #define TUP_DCD_ENDPOINT_MAX    8
+
 //--------------------------------------------------------------------+
 // Broadcom
 //--------------------------------------------------------------------+
diff --git a/src/tusb_option.h b/src/tusb_option.h
