 TU_ATTR_ALWAYS_INLINE static inline bool queue_event(dcd_event_t const * event, bool in_isr) {
-  TU_ASSERT(osal_queue_send(_usbd_q, event, in_isr));
+  bool const sent = osal_queue_send(_usbd_q, event, in_isr);
+#if CFG_TUSB_MCU == OPT_MCU_AT91SAM7S
+  if (!sent) return false;   /* SAM7 DCD retains the FIFO condition and retries */
+#else
+  TU_ASSERT(sent);
+#endif
   tud_event_hook_cb(event->rhport, event->event_id, in_isr);
   return true;
 }
 
+#if CFG_TUSB_MCU == OPT_MCU_AT91SAM7S
+/* The SAM7 control endpoint is only eight bytes, so a large request produces
+ * hundreds of setup/data/status interrupts.  Its DCD must not retire a FIFO
+ * condition unless every event it is about to publish fits in this finite
+ * queue.  Query with the ISR-safe FreeRTOS primitive; no queue storage or
+ * per-session state is added. */
+bool fantasi_usbd_event_queue_has_space(uint8_t count) {
+  UBaseType_t const waiting = uxQueueMessagesWaitingFromISR(_usbd_q);
+  return count <= CFG_TUD_TASK_QUEUE_SZ &&
+         waiting <= (UBaseType_t)(CFG_TUD_TASK_QUEUE_SZ - count);
+}
+
+/* The SAM7 DCD overrides this.  It re-enables a level interrupt that was
+ * paused while the queue was full, immediately after the consumer makes room. */
+TU_ATTR_WEAK void fantasi_dcd_event_queue_space(void) {}
+
+/* Zero-timeout event enqueue for USB-task context.  The SAM7 DCD finishes an
+ * early-consumed EP0 phase inside dcd_edpt_xfer (task context): the FromISR
+ * primitives are unsafe there, and the blocking task-side send would deadlock
+ * the queue's own consumer if the queue were full. */
+bool fantasi_usbd_queue_event_task(dcd_event_t const* event) {
+  if (xQueueSendToBack(_usbd_q, event, 0) != pdTRUE) return false;
+  tud_event_hook_cb(event->rhport, event->event_id, false);
+  return true;
+}
+
+/* PM3 EP0 completion events carry a seven-bit control-transaction epoch in
+ * the high byte of len. Synchronize the DCD task epoch only while the queued
+ * SETUP count is protected, closing the ISR race between deciding that a
+ * SETUP is current and beginning to process it. */
+void fantasi_dcd_control_task_sync(void);
+bool fantasi_dcd_control_event_matches_task(uint8_t epoch);
+#endif
+
