+#if CFG_TUSB_MCU == OPT_MCU_NRF5X
+bool fantasi_nrf_status_take(uint8_t* ep_addr);
+
+bool fantasi_usbd_setup_queued(void) {
+  taskENTER_CRITICAL();
+  bool const queued = _usbd_queued_setup != 0;
+  taskEXIT_CRITICAL();
+  return queued;
+}
+
+static void nrf_status_complete(void) {
+  uint8_t ep_addr;
+  if (!fantasi_nrf_status_take(&ep_addr)) return;
+
+  uint8_t const ep_dir = tu_edpt_dir(ep_addr);
+  _usbd_dev.ep_status[0][ep_dir].busy = 0;
+  _usbd_dev.ep_status[0][ep_dir].claimed = 0;
+  usbd_control_xfer_cb(0, ep_addr, XFER_RESULT_SUCCESS, 0);
+}
+#endif
